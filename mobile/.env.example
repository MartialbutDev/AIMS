# Copy to .env.local and replace the example LAN address with your PC IPv4.
# The phone and PC must be on the same Wi-Fi. These variables are public.
EXPO_PUBLIC_BASE_URL=http://192.168.1.10:8000
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1
# EAS preview/production keep their explicit EC2 HTTPS addresses in eas.json.
