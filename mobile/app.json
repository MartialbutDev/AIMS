{
  "expo": {
    "name": "AIMS",
    "slug": "aims",
    "version": "1.0.14",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/39788b8c-8550-496e-a907-08afba0d90fc",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/images/aims-identity-icon.png",
    "scheme": "aims",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 15,
      "adaptiveIcon": {
        "backgroundColor": "#0b0b2f",
        "foregroundImage": "./assets/images/aims-identity-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.aims.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/aims-identity-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/aims-identity-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0b0b2f",
          "dark": {
            "backgroundColor": "#0b0b2f"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/aims-notification-icon.png",
          "color": "#0B0B2F",
          "defaultChannel": "aims"
        }
      ],
      "./plugins/with-aims-network",
      "./plugins/with-aims-launcher-icon",
      "./plugins/with-aims-notification-logo"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "39788b8c-8550-496e-a907-08afba0d90fc"
      }
    }
  }
}
