{
  "expo": {
    "name": "AIMS",
    "slug": "aims",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/aims-app-icon.png",
    "scheme": "aims",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#080078",
        "foregroundImage": "./assets/images/aims-app-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.aims.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/aims-logo-source.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#080078",
          "dark": {
            "backgroundColor": "#080078"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "./plugins/with-aims-network"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "39788b8c-8550-496e-a907-08afba0d90fc"
      }
    }
  }
}
