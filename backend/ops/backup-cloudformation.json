{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "AIMS private encrypted offsite backups, limited EC2 role, SNS email and independent missing-heartbeat alarms. No changes to existing EC2 instance or application.",
  "Parameters": {
    "AlertEmail": {
      "Type": "String",
      "Description": "Address for AWS subscription confirmation and backup alerts; never enter credentials.",
      "AllowedPattern": "[^\\s@]+@[^\\s@]+\\.[^\\s@]+"
    },
    "InstanceId": {
      "Type": "String",
      "Default": "i-0b272a98618427620",
      "AllowedPattern": "i-[a-f0-9]{8,17}"
    }
  },
  "Resources": {
    "BackupBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "EncryptedBackupRetention",
              "Status": "Enabled",
              "Prefix": "production/",
              "ExpirationInDays": 90,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              },
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            },
            {
              "Id": "ExpiredDeleteMarkers",
              "Status": "Enabled",
              "Prefix": "production/",
              "ExpiredObjectDeleteMarker": true
            }
          ]
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "AIMS"
          },
          {
            "Key": "Purpose",
            "Value": "EncryptedBackups"
          }
        ]
      }
    },
    "BucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "BackupBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "RequireTLS",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "BackupBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${BackupBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Sid": "RequireConditionalCreate",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "${BackupBucket.Arn}/production/*"
              },
              "Condition": {
                "Null": {
                  "s3:if-none-match": "true"
                }
              }
            }
          ]
        }
      }
    },
    "AlertTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "DisplayName": "AIMS backup operations"
      }
    },
    "AlertSubscription": {
      "Type": "AWS::SNS::Subscription",
      "Properties": {
        "Protocol": "email",
        "Endpoint": {
          "Ref": "AlertEmail"
        },
        "TopicArn": {
          "Ref": "AlertTopic"
        }
      }
    },
    "AlertPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "Topics": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudwatch.amazonaws.com"
              },
              "Action": "sns:Publish",
              "Resource": {
                "Ref": "AlertTopic"
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:*"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "BackupRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Description": "AIMS encrypted backup replication and heartbeat; no delete or IAM permissions",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ScopedBackupOperations",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": {
                    "Fn::GetAtt": [
                      "BackupBucket",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${BackupBucket.Arn}/production/*"
                  }
                },
                {
                  "Effect": "Deny",
                  "Action": [
                    "s3:DeleteObject",
                    "s3:DeleteObjectVersion"
                  ],
                  "Resource": {
                    "Fn::Sub": "${BackupBucket.Arn}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "cloudwatch:PutMetricData",
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "cloudwatch:namespace": "AIMS/Backups"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "sns:Publish",
                  "Resource": {
                    "Ref": "AlertTopic"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "BackupInstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "BackupRole"
          }
        ]
      }
    },
    "BackupHealthyAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Local backup missing, failed or older than 30 hours; missing EC2 heartbeat also triggers this alarm",
        "Namespace": "AIMS/Backups",
        "MetricName": "BackupHealthy",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "InstanceId"
            }
          }
        ],
        "Statistic": "Minimum",
        "Period": 3600,
        "EvaluationPeriods": 2,
        "DatapointsToAlarm": 2,
        "Threshold": 1,
        "ComparisonOperator": "LessThanThreshold",
        "TreatMissingData": "breaching",
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "OKActions": [
          {
            "Ref": "AlertTopic"
          }
        ]
      }
    },
    "OffsiteHealthyAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Encrypted S3 copy missing, stale or checksum failed; missing EC2 heartbeat also triggers this alarm",
        "Namespace": "AIMS/Backups",
        "MetricName": "OffsiteHealthy",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "InstanceId"
            }
          }
        ],
        "Statistic": "Minimum",
        "Period": 3600,
        "EvaluationPeriods": 2,
        "DatapointsToAlarm": 2,
        "Threshold": 1,
        "ComparisonOperator": "LessThanThreshold",
        "TreatMissingData": "breaching",
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "OKActions": [
          {
            "Ref": "AlertTopic"
          }
        ]
      }
    },
    "RecoveryHealthyAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Independent local restore check overdue (35 days); missing EC2 heartbeat also triggers this alarm",
        "Namespace": "AIMS/Backups",
        "MetricName": "RecoveryHealthy",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "InstanceId"
            }
          }
        ],
        "Statistic": "Minimum",
        "Period": 3600,
        "EvaluationPeriods": 2,
        "DatapointsToAlarm": 2,
        "Threshold": 1,
        "ComparisonOperator": "LessThanThreshold",
        "TreatMissingData": "breaching",
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "OKActions": [
          {
            "Ref": "AlertTopic"
          }
        ]
      }
    }
  },
  "Outputs": {
    "BucketName": {
      "Value": {
        "Ref": "BackupBucket"
      }
    },
    "AlertTopicArn": {
      "Value": {
        "Ref": "AlertTopic"
      }
    },
    "InstanceProfileName": {
      "Value": {
        "Ref": "BackupInstanceProfile"
      }
    },
    "RoleName": {
      "Value": {
        "Ref": "BackupRole"
      }
    },
    "AccountId": {
      "Value": {
        "Ref": "AWS::AccountId"
      }
    },
    "Region": {
      "Value": {
        "Ref": "AWS::Region"
      }
    }
  }
}
