# Local development only. Copy to .env and fill the placeholders before use.
DATABASE_URL=postgresql://aims:REPLACE_PASSWORD@localhost:5432/aims_db
DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_AN_INDEPENDENT_RANDOM_KEY
CURRENT_ACADEMIC_YEAR=2026-2027
CURRENT_SEMESTER=1
PRACTICUM_SUBJECT_CODES=IT421
REQUIRED_INTERNSHIP_HOURS=486
TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe
RUN_NOTIFICATION_SCHEDULER=true
PUSH_DELIVERY_ENABLED=false
EMAIL_NOTIFICATION_DELIVERY_ENABLED=false
# Optional OTP transport. Keep the private key only in .env, never in Git/chat.
EMAILJS_SERVICE_ID=
EMAILJS_OTP_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
